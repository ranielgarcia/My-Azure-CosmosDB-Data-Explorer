# Cosmos DB endpoint (always required)
COSMOS_ENDPOINT=https://<your-account>.documents.azure.com:443/

# Auth mode: connection-string | azure-cli
COSMOS_AUTH_MODE=connection-string

# Primary key (required only when COSMOS_AUTH_MODE=connection-string)
COSMOS_KEY=<your-primary-key>

# --- Azure Table Storage ---

# Auth mode: connection-string | azure-cli
TABLE_AUTH_MODE=connection-string

# Connection string (required only when TABLE_AUTH_MODE=connection-string)
AZURE_TABLE_CONNECTION_STRING=<your-table-connection-string>

# Table service endpoint (required only when TABLE_AUTH_MODE=azure-cli)
# e.g. https://<your-account>.table.core.windows.net
AZURE_TABLE_ENDPOINT=https://<your-account>.table.core.windows.net

# Express proxy port
PORT=3001

# Client-side API base URL (defaults to /api via the Vite proxy)
VITE_API_BASE_URL=/api
